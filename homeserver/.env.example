# Kopieren nach .env und ausfüllen. Die echte .env gehört nicht ins Git.

# Die öffentliche Domain, unter der n8n erreichbar sein soll. Sie wird in
# Cloudflare beim Anlegen des Tunnels auf http://n8n:5678 gezeigt.
# Beispiel: n8n.deinedomain.de
N8N_HOST=

# Token aus dem Cloudflare-Dashboard:
# Zero Trust → Networks → Tunnels → Create a tunnel → Docker.
# Der angezeigte Befehl enthält den Token — nur den Wert hier einsetzen.
CLOUDFLARE_TUNNEL_TOKEN=

# Verschlüsselt die in n8n gespeicherten Zugangsdaten.
# Einmal erzeugen mit:  openssl rand -hex 32
# Danach sichern (Passwortmanager). Geht der Schlüssel verloren, sind alle
# hinterlegten Credentials unbrauchbar.
N8N_ENCRYPTION_KEY=
